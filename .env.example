# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/placement_management?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/placement_management
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/placement_management?retryWrites=true&w=majority

# Authentication Secret (Used for signing JSON Web Tokens)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client URL (For CORS authorization)
CLIENT_URL=http://localhost:5173
